{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=futuretech.db",
    "Postgres": "Host=localhost;Port=5432;Database=futuretech;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "futuretech-academy",
    "Audience": "futuretech-academy-web",
    "SigningKey": "dev-only-signing-key-change-me-in-production-0123456789",
    "ExpiryHours": 12
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:4173", "http://localhost:3000" ]
  },
  "Seed": {
    "Path": "SeedData",
    "CreateDemoUser": true
  },
  "Network": {
    // Turn on only when the API sits behind a proxy you control (nginx, a load
    // balancer). Otherwise a client could forge its own address in the audit.
    "TrustForwardedHeaders": false
  },
  "GeoIp": {
    // Set to false to stop the platform making any outbound location request.
    // Login history then shows the IP address without a city.
    "Enabled": true,
    "Endpoint": "http://ip-api.com/json/{ip}?fields=status,message,country,countryCode,regionName,city,timezone,isp,lat,lon",
    "Source": "ip-api.com",
    "TimeoutSeconds": 5,
    "CacheDays": 30,
    "MinIntervalMilliseconds": 1500
  }
}
